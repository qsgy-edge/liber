    "json": "{\"names\":[\"甲\",\"乙\"],\"items\":[{\"name\":\"丙\"},{\"name\":\"丁\"}]}"
  },
  "baseUrl": "http://fixture.test",
  "cases": [
    {
      "id": "html-list-ordered-hrefs",
      "document": "toc",
      "rule": "#list li@a@href",
      "method": "getStringList",
      "expected": [
        "/1",
        "/2",
        "/3"
      ]
    },
    {
      "id": "html-scalar-twin-ordered-hrefs",
      "document": "toc",
      "rule": "#list li@a@href",
      "method": "getString",
      "expected": "/1\n/2\n/3"
    },
    {
      "id": "html-list-declared-order",
      "document": "toc",
      "rule": "#list li[2,0,1]@a@href",
      "method": "getStringList",
      "expected": [
        "/3",
        "/1",
        "/2"
      ]
    },
    {
      "id": "html-list-per-item-replacement",
      "document": "toc",
      "rule": "#list li@a@href##^/##/page/",
      "method": "getStringList",
      "expected": [
        "/page/1",
        "/page/2",
        "/page/3"
      ]
    },
    {
      "id": "html-scalar-joined-replacement-twin",
      "document": "toc",
      "rule": "#list li@a@href##^/##/page/",
      "method": "getString",
      "expected": "/page/1\n/2\n/3"
    },
    {
      "id": "html-list-empty",
      "document": "toc",
      "rule": "a.absent@href",
      "method": "getStringList",
      "expected": []
    },
    {
      "id": "html-list-url-empty",
      "document": "toc",
      "rule": "a.absent@href##$##/missing",
      "method": "getStringListUrl",
      "expected": []
    },
    {
      "id": "html-list-entity-no-unescape",
      "document": "entity",
      "rule": "#code@text",
      "method": "getStringList",
      "expected": [
        "A&amp;B"
      ]
    },
    {
      "id": "html-scalar-entity-twin",
      "document": "entity",
      "rule": "#code@text",
      "method": "getString",
      "expected": "A&B"
    },
    {
      "id": "json-list-string-names",
      "document": "json",
      "rule": "@Json:$.names[*]",
      "path": "json",
      "method": "getStringList",
      "expected": [
        "甲",
        "乙"
      ]
    },
    {
      "id": "json-scalar-string-twin",
      "document": "json",
      "rule": "@Json:$.names[*]",
      "path": "json",
      "method": "getString",
      "expected": "甲\n乙"
    }
  ],
