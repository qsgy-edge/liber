{
  "id": "WV-13",
  "http500Path": "/http-500",
  "abortPath": "/abort",
  "webView500Path": "/webview-500",
  "javaScript": "document.body.innerText",
  "routes": [
    {"method": "GET", "path": "/http-500", "status": 500, "reason": "Internal Server Error", "body": "http-500"},
