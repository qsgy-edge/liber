    {"method": "GET", "path": "/webview-500", "status": 500, "reason": "Internal Server Error", "headers": {"Content-Type": "text/html; charset=utf-8"}, "body": "<!doctype html><html><body>webview-500</body></html>"},
    {"method": "GET", "path": "/favicon.ico", "status": 404, "reason": "Not Found", "body": ""}
  ]
}
