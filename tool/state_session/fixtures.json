  "policyRows": [
    {
      "id": "java-get-put-entity-ladder",
      "status": "not-compared",
      "reason": "The frozen AnalyzeRule.put/get ladder writes the bound chapter/book entity and falls back to the per-source row only when no entity is bound (AnalyzeRule.kt:718-744), while the product's java.put/java.get address the per-source v_ row (ADR 0011 section 3, ticket #21). That accepted difference stays out of this corpus: no script here calls java.get or java.put.",
      "owner": "consumer declares its own product-policy checks over declared keys, outside the 26 frozen observation ids"
    },
    {
      "id": "chapter-wordcount-carry",
      "status": "not-compared",
      "reason": "AppConfig.tocCountWords defaults to true (AppConfig.kt:384-385), so the frozen TOC reads the previous chapters rows for wordCount (BookChapterList.kt:271-285); the product store has no chapter wordCount column. Coverage gap, not a compared row."
    },
    {
      "id": "native-return-strict-equality",
      "status": "not-compared",
      "reason": "The frozen document, attribute and getVariable values reach a script as Java-backed Strings, so a === comparison against a JS string literal does not hold on them. This corpus converts such a value with String(...) before comparing, so the declared writes are exercised as JS primitives. Interop between native-returned values and strict equality is left to #137 and this corpus accepts no difference on it."
    },
    {
      "id": "search-entity-bindings",
      "status": "not-compared",
      "reason": "The search stage binds a SearchBook in the frozen app (BookList.kt:202-207) and the product's search snapshot has no book, so this corpus calls only source.* in the search script and makes no new search-entity claim."
    }
  ],
  "coverageGaps": [
    "One HTML source and one JSON source, three books, five chapter reads: a state/session comparison boundary, not a source or platform claim.",
    "No login, cookie-jar write, cache byte payload, TLS exception, rate limiter, WebView, Java get/put or concurrency row.",
    "No ruleToc.nextTocUrl or ruleContent.nextContentUrl pagination; each stage fetches one page per step.",
    "Chapter wordCount carry and search-entity bindings are declared not-compared above."
