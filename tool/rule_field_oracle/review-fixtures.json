  {
    "name": "multiple-siblings-count",
    "rule": "{{java.put('count','1'); 'literal'}}<js>java.put('count', String(Number(java.get('count'))+1)); result+'1'</js><js>java.put('count', String(Number(java.get('count'))+1)); result+'2'</js>"
  },
  {
    "name": "cancelled-expression",
    "rule": "{{'literal'}}",
    "form": "cancelled"
  },
  {
    "name": "kind-node-multiline",
    "rule": "{{'甲\\n乙'}}",
    "type": "node",
    "content": "<ul><li><a href=\"/book\">body</a></li></ul>",
    "form": "list"
  },
  {
    "name": "kind-map-multiline",
    "rule": "{{'甲\\n乙'}}",
    "type": "map",
    "content": "{\"item\":{\"name\":\"body\",\"path\":\"/book\"}}",
    "form": "list"
  },
  {
    "name": "item-sequence",
    "rule": "{{java.put('count', String(Number(java.get('count') || 0) + 1)); String(result).indexOf('完结') >= 0 ? '完结' : '连载'}}",
    "content": "<ul><li><a href=\"/one\">完结</a></li><li><a href=\"/two\">连载</a></li></ul>",
    "form": "items"
  },
  {
    "name": "native-object-scalar",
    "rule": "{{'object'}}",
    "content": "{\"object\":{\"name\":\"body\"}}",
    "type": "nativeObject",
    "form": "scalar"
  },
  {
    "name": "native-object-list",
    "rule": "{{'object'}}",
    "content": "{\"object\":{\"name\":\"body\"}}",
    "type": "nativeObject",
    "form": "list"
  },
  {
    "name": "native-array-scalar",
    "rule": "{{'array'}}",
    "content": "{\"array\":[\"a\",null,\"b\"]}",
    "type": "nativeObject",
    "form": "scalar"
  },
  {
    "name": "native-array-list",
    "rule": "{{'array'}}",
    "content": "{\"array\":[\"a\",null,\"b\"]}",
    "type": "nativeObject",
    "form": "list"
  },
  {
    "name": "node-string-scalar-entity",
    "rule": "{{String(result)}}",
    "content": "<ul><li><a href=\"/book\">A&amp;amp;</a></li></ul>",
    "type": "node"
  },
  {
    "name": "node-string-before-scalar",
    "rule": "{{String(result)}} @js: result.indexOf('&amp;amp;') >= 0 ? 'raw-node' : 'decoded-node'",
    "content": "<ul><li><a href=\"/book\">A&amp;amp;</a></li></ul>",
    "type": "node"
  },
  {
    "name": "map-script-string",
    "rule": "{{String(result)}}",
    "type": "map",
    "content": "{\"item\":{\"name\":\"body\"}}"
  },
  {
    "name": "list-script-string",
    "rule": "{{String(result)}}",
    "type": "list",
    "content": "{\"list\":[\"name\",\"body\"]}"
  },
  {
    "name": "nativeObject-script-string",
    "rule": "{{String(result)}}",
    "type": "nativeObject",
    "content": "{\"name\":\"body\"}"
  },
  {
    "name": "url-toc-sibling",
    "rule": "{{'/toc'}} @js: result == '/toc' ? '/ok' : '/bad'",
    "content": "{\"name\":\"body\"}",
    "url": true,
    "base": "https://review-rules.test/book"
  },
  {
    "name": "url-toc-empty-script",
    "rule": "{{'/toc'}} @js:''",
    "content": "{\"name\":\"body\"}",
    "url": true,
    "base": "https://review-rules.test/book"
  }
]
