[
  {
    "name": "generated-@@h1@text",
    "rule": "{{'@@h1@text'}}",
    "type": "node",
    "content": "<ul><li><a href=\"/book\">body</a></li></ul>"
  },
  {
    "name": "generated-@json",
    "rule": "{{'@json:$.name'}}",
    "type": "node",
    "content": "<ul><li><a href=\"/book\">body</a></li></ul>"
  },
  {
    "name": "generated-@xpath",
    "rule": "{{'@xpath://p'}}",
    "type": "node",
    "content": "<ul><li><a href=\"/book\">body</a></li></ul>"
  },
  {
    "name": "empty-regex",
    "rule": "{{null}}##",
    "content": "{\"name\":\"body\",\"toc\":\"/toc\"}",
    "unescape": false
  },
  {
    "name": "zero-width",
    "rule": "{{'body'}}####X",
    "content": "{\"name\":\"body\",\"toc\":\"/toc\"}",
    "unescape": false
  },
  {
    "name": "empty-nonempty-regex",
    "rule": "{{null}}##name##title",
    "content": "{\"name\":\"body\",\"toc\":\"/toc\"}",
    "unescape": false
  },
  {
    "name": "node-empty-replacement",
    "rule": "{{null}}##body##title",
    "type": "node",
    "content": "<ul><li><a href=\"/book\">body</a></li></ul>"
  },
  {
    "name": "scalar-entity",
    "rule": "{{'A &amp; B'}}",
    "type": "node",
    "content": "<ul><li><a href=\"/book\">body</a></li></ul>"
  },
  {
    "name": "item-completed",
    "rule": "{{java.put('count', String(Number(java.get('count') || 0) + 1)); String(result).indexOf('完结') >= 0 ? '完结' : '连载'}}",
    "type": "node",
    "content": "<ul><li><a href=\"/book\">完结</a></li></ul>"
  },
  {
    "name": "item-ongoing",
    "rule": "{{java.put('count', String(Number(java.get('count') || 0) + 1)); String(result).indexOf('完结') >= 0 ? '完结' : '连载'}}",
    "type": "node",
    "content": "<ul><li><a href=\"/book\">连载</a></li></ul>"
  },
  {
    "name": "url-sibling",
    "rule": "{{'/book'}} @js: result.trim() == '/book' ? '/ok' : '/bad'",
    "content": "{\"name\":\"body\"}",
    "url": true
  },
  {
    "name": "url-empty",
    "rule": "{{null}}",
    "type": "node",
    "content": "<ul><li><a href=\"/book\">body</a></li></ul>",
    "url": true
  },
  {
    "name": "url-empty-after-script",
    "rule": "{{'/book'}} @js:''",
    "content": "{\"name\":\"body\"}",
    "url": true
  },
  {
    "name": "string-empty-replacement",
    "rule": "{{null}}##name##title",
    "type": "string",
    "content": "{\"name\":\"body\"}",
    "unescape": false
  },
  {
    "name": "string-sole-expression",
    "rule": "{{'body'}}",
    "type": "string",
    "content": "{\"name\":\"body\"}",
    "unescape": false
  },
  {
    "name": "string-mixed-expression",
    "rule": "prefix{{'body'}}",
    "type": "string",
    "content": "{\"name\":\"body\"}",
    "unescape": false
  },
  {
    "name": "map-empty-replacement",
    "rule": "{{null}}##name##title",
    "type": "map",
    "content": "{\"item\":{\"name\":\"body\"}}",
    "unescape": false
  },
  {
    "name": "map-sole-expression",
    "rule": "{{'body'}}",
    "type": "map",
    "content": "{\"item\":{\"name\":\"body\"}}",
    "unescape": false
  },
  {
    "name": "map-mixed-expression",
    "rule": "prefix{{'body'}}",
    "type": "map",
    "content": "{\"item\":{\"name\":\"body\"}}",
    "unescape": false
  },
  {
    "name": "list-empty-replacement",
    "rule": "{{null}}##name##title",
    "type": "list",
    "content": "{\"list\":[\"name\",\"body\"]}",
    "unescape": false
  },
  {
    "name": "list-sole-expression",
    "rule": "{{'body'}}",
    "type": "list",
    "content": "{\"list\":[\"name\",\"body\"]}",
    "unescape": false
  },
  {
    "name": "list-mixed-expression",
    "rule": "prefix{{'body'}}",
    "type": "list",
    "content": "{\"list\":[\"name\",\"body\"]}",
    "unescape": false
  },
  {
    "name": "nativeObject-empty-replacement",
    "rule": "{{null}}##name##title",
    "type": "nativeObject",
    "content": "{\"name\":\"body\",\"body\":\"native-value\"}",
    "unescape": false
  },
  {
    "name": "nativeObject-sole-expression",
    "rule": "{{'body'}}",
    "type": "nativeObject",
    "content": "{\"name\":\"body\",\"body\":\"native-value\"}",
    "unescape": false
  },
  {
    "name": "nativeObject-mixed-expression",
    "rule": "prefix{{'body'}}",
    "type": "nativeObject",
    "content": "{\"name\":\"body\",\"body\":\"native-value\"}",
    "unescape": false
  },
  {
    "name": "kind-string-named",
    "rule": "{{'甲\\n乙 &amp;'}}",
    "content": "<p>body</p>",
    "type": "string",
    "form": "list"
  },
  {
    "name": "kind-map-named",
    "rule": "{{'甲\\n乙 &amp;'}}",
    "content": "{\"item\":{\"name\":\"body\"}}",
    "type": "map",
    "form": "list"
  },
  {
    "name": "kind-string-blank",
    "rule": "{{null}}",
    "content": "<p>body</p>",
    "type": "string",
    "form": "list"
  },
  {
    "name": "kind-map-blank",
    "rule": "{{null}}",
    "content": "{\"item\":{\"name\":\"body\"}}",
    "type": "map",
    "form": "list"
  },
  {
    "name": "kind-string-replacement",
    "rule": "{{'甲\\n乙'}}##甲##丙",
    "content": "<p>body</p>",
    "type": "string",
    "form": "list"
  },
  {
    "name": "kind-map-replacement",
    "rule": "{{'甲\\n乙'}}##甲##丙",
    "content": "{\"item\":{\"name\":\"body\"}}",
    "type": "map",
    "form": "list"
  },
  {
    "name": "kind-string-js-list",
    "rule": "{{'甲'}} @js: ['a &amp;', 'b']",
    "content": "<p>body</p>",
    "type": "string",
    "form": "list"
  },
  {
    "name": "kind-map-js-list",
    "rule": "{{'甲'}} @js: ['a &amp;', 'b']",
    "content": "{\"item\":{\"name\":\"body\"}}",
    "type": "map",
    "form": "list"
  },
  {
    "name": "original-@@",
    "rule": "@@{{'@@value'}}",
    "unescape": false
  },
  {
    "name": "original-@json:",
    "rule": "@json:{{'@@value'}}",
    "unescape": false
  },
  {
    "name": "original-@xpath:",
    "rule": "@xpath:{{'@@value'}}",
    "unescape": false
  },
  {
    "name": "post-script",
    "rule": "{{'A &amp;'}} @js: result + ' &lt;b&gt;'",
    "unescape": true
  },
  {
    "name": "single-pass",
    "rule": "{{'&amp;amp;'}}",
    "unescape": true
  },
  {
    "name": "content-false",
    "rule": "{{'&amp;amp;'}}",
    "unescape": false
  },
  {
    "name": "encoded-put",
    "rule": "@put:{\"saved\":\"@js: '&amp;amp;'\"}{{java.get('saved')}}",
    "unescape": true
  },
