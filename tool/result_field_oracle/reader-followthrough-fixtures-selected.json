  "scenario": [
    "html-body-replace-title-order: search, information, TOC, then two serial HTML content pages. The first page body writes source-owned state, the joined-content replacement rewrites it, and the title reads that state plus the first-page title marker; the second page carries a distinct title marker.",
    "json-body-title-order: search, information, TOC, then two serial JSON content pages. The first page body writes source-owned state and the title reads it plus the first-page title marker; the second page carries a distinct title marker. No replaceRegex is declared.",
    "html-order-control: search, information, TOC, then one HTML content page. Static content, replacement and title are independent of source state; ordinary content and both introductions carry literal escaped line breaks."
  ],
