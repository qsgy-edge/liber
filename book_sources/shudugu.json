      "intro": "@CSS:.des p@text",
      "kind": "@CSS:.itemtxt p span@text",
      "tocUrl": "@CSS:#dir a@href"
    },
    "ruleToc": {
      "chapterList": "@CSS:#list li a",
      "chapterName": "@CSS:a@text",
      "chapterUrl": "@CSS:a@href",
