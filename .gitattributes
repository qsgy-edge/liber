# Byte-exact data is read for its bytes, not for its lines. The text engine's
# fixtures are the reader's hand-computed byte and code-unit offsets, and its
# tables are the conversion data a provenance note pins; without this a Windows
# checkout with core.autocrlf=true turns every LF into CRLF and the offsets come
# out one byte per line too large (measured: +74 and +23 on the two fixtures).
packages/fjs/liber_text/tests/data/** text eol=lf
packages/fjs/liber_text/assets/** text eol=lf

# Device-produced oracle evidence is compared by byte hash (see manifest.json in each
# evidence directory). Without this a Windows checkout with core.autocrlf=true rewrites
# the LF bytes the device wrote, and the manifest pins stop matching.
tool/nested_oracle/evidence/** text eol=lf
tool/first_slice/evidence/** text eol=lf
# The SLICE-01 corpus is a compared input: its committed bytes are its identity, and
# the harness serves an asset copy of them (see the golden's manifest).
tool/first_slice/fixtures.json text eol=lf
# The FIELDS-01 corpus and the evidence that pins its bytes are read for their bytes
# the same way: the comparator refuses to compare when the corpus bytes hash to
# anything but the value the observation and manifest recorded.
tool/result_field_oracle/fixtures.json text eol=lf
tool/result_field_oracle/evidence/** text eol=lf
# The harness serves the corpus out of its assets, so the runner is not shipped;
# this line keeps the matching-rule reference byte-stable alongside it.
tool/first_slice/runner.dart text eol=lf
# The #65 HTML/JSON no-match oracle pins the on-device corpus and harness
# source bytes as well as its reports; keep those hashes stable on every host.
tool/html_oracle/fixtures.json text eol=lf
tool/html_oracle/evidence/** text eol=lf
tool/nested_oracle/HtmlOracle.java text eol=lf
tool/nested_oracle/build.ps1 text eol=lf
tool/nested_oracle/AndroidManifest.xml text eol=lf
# The REPLACE-JS-01 corpus, its harness sources and the evidence that pins their
# bytes are all hashed: the harness serves the corpus out of its assets, the
# manifest pins the harness sources, and the golden records the corpus hash the
# comparator refuses to compare without. Without this a Windows checkout with
# core.autocrlf=true rewrites the LF bytes and every pin stops matching (#41 hit
# the same gap during merge verification).
tool/replace_js_oracle/** text eol=lf
# The WebView contract harness and every byte it pins are read for their bytes:
# the fixtures and goldens the comparator refuses to compare without matching
# hashes, the evidence and manifests a sweep produces, and the sources the
# manifest writer hashes. Without this a Windows checkout with core.autocrlf=true
# rewrites the LF bytes and every pin stops matching (#55 hit the same gap as #41).
tool/webview_oracle/** text eol=lf
# ... except the harness's own binary resources, which are not lines at all.
tool/webview_oracle/**/*.png -text
tool/webview_oracle/**/*.ico -text

# The JSONPath probe's transcript is the recorded evidence every JSONPath comment
# and test expectation cites, and `jars.sha256` is compared by `run.sh` against
# the jars it downloads; without this a Windows checkout with core.autocrlf=true
# rewrites the LF bytes of both (#44).
tool/jsonpath_probe/** text eol=lf
